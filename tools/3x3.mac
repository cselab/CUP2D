load("cgrind");
A: matrix([xx, 0, xz], [0, yy, yz], [zx, zy, zz]);
b: matrix([x], [y], [z]);

D: determinant(A);
M: lu_factor(A);
x: lu_backsub(M, b);

fullratsimp(A . x - b);

x: map(fullratsimp, x * D / 'D);

(cgrind('D = factor(D)),
  cgrind('u = x[1, 1]),
  cgrind('v = x[2, 1]),
 cgrind('omega = x[3, 1]));

